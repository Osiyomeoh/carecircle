{
  "name": "carecircle-mcp",
  "version": "0.1.0",
  "description": "An open-source MCP server for shared household care coordination. Events -> Obligations -> Ownership.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/http.ts",
    "start": "node dist/http.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/sim/app.ts",
    "demo": "npm run build && node dist/http.js",
    "e2e": "tsx scripts/e2e.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "evals": "tsx scripts/evals.ts",
    "dynamo:check": "tsx scripts/dynamo-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1131.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1131.0",
    "@aws-sdk/client-dynamodb": "^3.1132.0",
    "@aws-sdk/lib-dynamodb": "^3.1132.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
